<Window x:Class="Motion2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Motion Showreel 2.0"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.EdgeMode="Aliased">

    <Window.Resources>
        <Color x:Key="Neon1">#FF00F5FF</Color>
        <Color x:Key="Neon2">#FFFF00DC</Color>
        <Color x:Key="Neon3">#FF00FFA3</Color>
        <Color x:Key="Neon4">#FFFFD700</Color>
        <SolidColorBrush x:Key="Cyan" Color="#00F5FF" />
        <SolidColorBrush x:Key="Magenta" Color="#FF00DC" />
        <SolidColorBrush x:Key="Yellow" Color="#FFD700" />
        <SolidColorBrush x:Key="Green" Color="#00FFA3" />
        <SolidColorBrush x:Key="White" Color="#FFFFFF" />

        <Storyboard x:Key="ShowreelStoryboard"
                    RepeatBehavior="Forever"
                    Duration="0:0:15"
                    FillBehavior="HoldEnd"
                    Timeline.DesiredFrameRate="60">

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="BgGradient"
                                         Storyboard.TargetProperty="(RadialGradientBrush.GradientStops)[0].(GradientStop.Color)">
                <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#1A0A1A" />
                <SplineColorKeyFrame KeyTime="0:0:3.5" Value="#0A0A2A" KeySpline="0.4,0,0.6,1" />
                <SplineColorKeyFrame KeyTime="0:0:7.5" Value="#1A0A1F" KeySpline="0.4,0,0.6,1" />
                <SplineColorKeyFrame KeyTime="0:0:11.5" Value="#0F1A0A" KeySpline="0.4,0,0.6,1" />
                <SplineColorKeyFrame KeyTime="0:0:15" Value="#1A0A1A" KeySpline="0.4,0,0.6,1" />
            </ColorAnimationUsingKeyFrames>

            <!--<DoubleAnimation Storyboard.TargetName="ParticleOrbit1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                             From="0"
                             To="360"
                             Duration="0:0:15" />

            <DoubleAnimation Storyboard.TargetName="ParticleOrbit2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                             From="360"
                             To="0"
                             Duration="0:0:12" />

            <DoubleAnimation Storyboard.TargetName="ParticleOrbit3"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                             From="0"
                             To="-360"
                             Duration="0:0:18" />-->

            <!--<DoubleAnimation Storyboard.TargetName="Scene1Logo"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                             From="0"
                             To="360"
                             Duration="0:0:15" />-->

            <!--<DoubleAnimation Storyboard.TargetName="HexRotate1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                             From="0"
                             To="720"
                             Duration="0:0:15"
                             BeginTime="0:0:3.8" />

            <DoubleAnimation Storyboard.TargetName="HexRotate2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                             From="0"
                             To="-540"
                             Duration="0:0:15"
                             BeginTime="0:0:3.8" />-->

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scene1"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="1" KeySpline="0.3,0 0.2,1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.5" Value="1" />
                <SplineDoubleKeyFrame KeyTime="0:0:4.2" Value="0" KeySpline="0.8,0 0.9,0.3" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scene1Scale"
                                           Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" KeySpline="0.2,1 0.3,1" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.2,1 0.3,1" />
                <SplineDoubleKeyFrame KeyTime="0:0:4.2" Value="1.3" KeySpline="0.7,0 0.8,0.2" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scene1Scale"
                                           Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" KeySpline="0.2,1 0.3,1" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.2,1 0.3,1" />
                <SplineDoubleKeyFrame KeyTime="0:0:4.2" Value="1.3" KeySpline="0.7,0 0.8,0.2" />
            </DoubleAnimationUsingKeyFrames>

            <!--<DoubleAnimation Storyboard.TargetName="Scene1Logo"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                             From="0"
                             To="360"
                             Duration="0:0:15" />-->

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scene2"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.8" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:4.5" Value="1" KeySpline="0.3,0 0.2,1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:7.5" Value="1" />
                <SplineDoubleKeyFrame KeyTime="0:0:8.2" Value="0" KeySpline="0.8,0 0.9,0.3" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scene2Shift"
                                           Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.8" Value="-60" />
                <SplineDoubleKeyFrame KeyTime="0:0:4.9" Value="0" KeySpline="0.2,1 0.3,1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:7.2" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:8.2" Value="60" KeySpline="0.7,0 0.8,0.2" />
            </DoubleAnimationUsingKeyFrames>

            <!--<DoubleAnimation Storyboard.TargetName="HexRotate1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                             From="0"
                             To="720"
                             Duration="0:0:15"
                             BeginTime="0:0:3.8" />

            <DoubleAnimation Storyboard.TargetName="HexRotate2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                             From="0"
                             To="-540"
                             Duration="0:0:15"
                             BeginTime="0:0:3.8" />-->

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scene3"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:7.8" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:8.5" Value="1" KeySpline="0.3,0 0.2,1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:11.5" Value="1" />
                <SplineDoubleKeyFrame KeyTime="0:0:12.2" Value="0" KeySpline="0.8,0 0.9,0.3" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scene3Scale"
                                           Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:7.8" Value="0.8" />
                <SplineDoubleKeyFrame KeyTime="0:0:9.2" Value="1" KeySpline="0.2,1 0.3,1" />
                <SplineDoubleKeyFrame KeyTime="0:0:12.2" Value="1.2" KeySpline="0.7,0 0.8,0.2" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scene3Scale"
                                           Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:7.8" Value="0.8" />
                <SplineDoubleKeyFrame KeyTime="0:0:9.2" Value="1" KeySpline="0.2,1 0.3,1" />
                <SplineDoubleKeyFrame KeyTime="0:0:12.2" Value="1.2" KeySpline="0.7,0 0.8,0.2" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetName="Wave1Scale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.5"
                             To="2"
                             Duration="0:0:0.8"
                             AutoReverse="True"
                             RepeatBehavior="Forever"
                             BeginTime="0:0:8" />

            <DoubleAnimation Storyboard.TargetName="Wave2Scale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.6"
                             To="2.2"
                             Duration="0:0:0.6"
                             AutoReverse="True"
                             RepeatBehavior="Forever"
                             BeginTime="0:0:8" />

            <DoubleAnimation Storyboard.TargetName="Wave3Scale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.7"
                             To="2.4"
                             Duration="0:0:0.7"
                             AutoReverse="True"
                             RepeatBehavior="Forever"
                             BeginTime="0:0:8" />

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scene4"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:11.8" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:12.5" Value="1" KeySpline="0.3,0 0.2,1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:14.5" Value="1" />
                <SplineDoubleKeyFrame KeyTime="0:0:15" Value="0" KeySpline="0.8,0 0.9,0.3" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scene4Scale"
                                           Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:11.8" Value="0.85" />
                <SplineDoubleKeyFrame KeyTime="0:0:13" Value="1" KeySpline="0.2,1 0.3,1" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scene4Scale"
                                           Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:11.8" Value="0.85" />
                <SplineDoubleKeyFrame KeyTime="0:0:13" Value="1" KeySpline="0.2,1 0.3,1" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetName="ProgressScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0"
                             To="1"
                             Duration="0:0:15" />

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ProgressGradient"
                                         Storyboard.TargetProperty="(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)">
                <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#00F5FF" />
                <LinearColorKeyFrame KeyTime="0:0:5" Value="#FF00DC" />
                <LinearColorKeyFrame KeyTime="0:0:10" Value="#00FFA3" />
                <LinearColorKeyFrame KeyTime="0:0:15" Value="#FFD700" />
            </ColorAnimationUsingKeyFrames>

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ProgressGradient"
                                         Storyboard.TargetProperty="(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)">
                <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#FF00DC" />
                <LinearColorKeyFrame KeyTime="0:0:5" Value="#FFD700" />
                <LinearColorKeyFrame KeyTime="0:0:10" Value="#00F5FF" />
                <LinearColorKeyFrame KeyTime="0:0:15" Value="#FF00DC" />
            </ColorAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush x:Name="BgGradient" GradientOrigin="0.5,0.5" RadiusX="1" RadiusY="1">
                <GradientStop Color="#1A0A1A" Offset="0" />
                <GradientStop Color="#000000" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Viewbox Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
            <Grid x:Name="SceneRoot" Width="1920" Height="1080" ClipToBounds="True">

                <Canvas x:Name="ParticleLayer" CacheMode="BitmapCache">
                    <Ellipse Width="900" Height="900" Canvas.Left="-300" Canvas.Top="-200" Opacity="0.15">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="{StaticResource Neon1}" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="1100" Height="1100" Canvas.Left="1120" Canvas.Top="180" Opacity="0.12">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="{StaticResource Neon2}" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Canvas x:Name="ParticleOrbit1" Width="1920" Height="1080" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="0" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Ellipse Width="20" Height="20" Fill="{StaticResource Cyan}" Canvas.Left="280" Canvas.Top="120" Opacity="0.7" />
                        <Ellipse Width="14" Height="14" Fill="{StaticResource Yellow}" Canvas.Left="1620" Canvas.Top="180" Opacity="0.6" />
                        <Ellipse Width="16" Height="16" Fill="{StaticResource Green}" Canvas.Left="190" Canvas.Top="850" Opacity="0.7" />
                        <Ellipse Width="18" Height="18" Fill="{StaticResource Magenta}" Canvas.Left="1740" Canvas.Top="920" Opacity="0.6" />
                        <Ellipse Width="12" Height="12" Fill="{StaticResource White}" Canvas.Left="480" Canvas.Top="200" Opacity="0.8" />
                    </Canvas>

                    <Canvas x:Name="ParticleOrbit2" Width="1920" Height="1080" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="360" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource Cyan}" Canvas.Left="720" Canvas.Top="90" Opacity="0.5" />
                        <Ellipse Width="14" Height="14" Fill="{StaticResource Magenta}" Canvas.Left="1810" Canvas.Top="580" Opacity="0.6" />
                        <Ellipse Width="12" Height="12" Fill="{StaticResource Yellow}" Canvas.Left="920" Canvas.Top="980" Opacity="0.6" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Canvas.Left="110" Canvas.Top="420" Opacity="0.5" />
                    </Canvas>

                    <Canvas x:Name="ParticleOrbit3" Width="1920" Height="1080" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="0" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Ellipse Width="16" Height="16" Fill="{StaticResource Yellow}" Canvas.Left="1280" Canvas.Top="140" Opacity="0.7" />
                        <Ellipse Width="10" Height="10" Fill="{StaticResource Cyan}" Canvas.Left="360" Canvas.Top="680" Opacity="0.6" />
                        <Ellipse Width="14" Height="14" Fill="{StaticResource Green}" Canvas.Left="1620" Canvas.Top="780" Opacity="0.7" />
                    </Canvas>
                </Canvas>

                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="1720" Height="900">

                    <Grid x:Name="Scene1" Opacity="0" CacheMode="BitmapCache">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Scene1Scale" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Ellipse Width="420" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="Scene1Logo" Angle="0" />
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource Neon1}" Offset="0" />
                                    <GradientStop Color="{StaticResource Neon2}" Offset="0.5" />
                                    <GradientStop Color="{StaticResource Neon3}" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                            <Ellipse.StrokeThickness>8</Ellipse.StrokeThickness>
                        </Ellipse>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="SHOWREEL 2.0" Foreground="#99FFFFFF" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="MOTION" Foreground="{StaticResource Cyan}" FontSize="128" FontWeight="Black" HorizontalAlignment="Center" Margin="0,16,0,0" />
                            <TextBlock Text="DESIGNER" Foreground="{StaticResource Magenta}" FontSize="128" FontWeight="Black" HorizontalAlignment="Center" Margin="0,-20,0,0" />
                            <TextBlock Text="PERFORMANCE OPTIMIZED • 60 FPS" Foreground="{StaticResource Yellow}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="Scene2" Opacity="0" CacheMode="BitmapCache">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="Scene2Shift" X="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="DYNAMIC • LAYERED • PRECISE" Foreground="#CCFFFFFF" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,48,0,0">
                                <Grid Width="240" Height="240" Margin="20">
                                    <Polygon Points="120,10 230,80 230,200 120,270 10,200 10,80" Stroke="{StaticResource Cyan}" StrokeThickness="6" RenderTransformOrigin="0.5,0.5">
                                        <Polygon.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform x:Name="HexRotate1" Angle="0" />
                                            </TransformGroup>
                                        </Polygon.RenderTransform>
                                    </Polygon>
                                    <TextBlock Text="3D" Foreground="{StaticResource Cyan}" FontSize="72" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Width="240" Height="240" Margin="20">
                                    <Polygon Points="120,10 230,80 230,200 120,270 10,200 10,80" Stroke="{StaticResource Magenta}" StrokeThickness="6" RenderTransformOrigin="0.5,0.5">
                                        <Polygon.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform x:Name="HexRotate2" Angle="0" />
                                            </TransformGroup>
                                        </Polygon.RenderTransform>
                                    </Polygon>
                                    <TextBlock Text="FX" Foreground="{StaticResource Magenta}" FontSize="72" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Width="240" Height="240" Margin="20">
                                    <Ellipse Stroke="{StaticResource Yellow}" StrokeThickness="6" />
                                    <TextBlock Text="UI" Foreground="{StaticResource Yellow}" FontSize="72" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="CRAFTING VISUAL EXPERIENCES" Foreground="{StaticResource Green}" FontSize="64" FontWeight="Black" HorizontalAlignment="Center" Margin="0,48,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="Scene3" Opacity="0" CacheMode="BitmapCache">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Scene3Scale" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="RHYTHM • ENERGY • IMPACT" Foreground="#FFFFFF" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,60,0,0">
                                <Border Width="120" Height="340" CornerRadius="30" Background="#15FFFFFF" Margin="24,0">
                                    <Ellipse Width="80" Height="280" Fill="{StaticResource Cyan}" VerticalAlignment="Bottom" HorizontalAlignment="Center" RenderTransformOrigin="0.5,1" Opacity="0.9">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="Wave1Scale" ScaleX="1" ScaleY="0.5" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>

                                <Border Width="120" Height="340" CornerRadius="30" Background="#15FFFFFF" Margin="24,0">
                                    <Ellipse Width="80" Height="280" Fill="{StaticResource Magenta}" VerticalAlignment="Bottom" HorizontalAlignment="Center" RenderTransformOrigin="0.5,1" Opacity="0.9">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="Wave2Scale" ScaleX="1" ScaleY="0.6" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>

                                <Border Width="120" Height="340" CornerRadius="30" Background="#15FFFFFF" Margin="24,0">
                                    <Ellipse Width="80" Height="280" Fill="{StaticResource Yellow}" VerticalAlignment="Bottom" HorizontalAlignment="Center" RenderTransformOrigin="0.5,1" Opacity="0.9">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="Wave3Scale" ScaleX="1" ScaleY="0.7" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>

                                <Border Width="120" Height="340" CornerRadius="30" Background="#15FFFFFF" Margin="24,0">
                                    <Ellipse Width="80" Height="280" Fill="{StaticResource Green}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0.8" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="EVERY FRAME TELLS A STORY" Foreground="{StaticResource White}" FontSize="56" FontWeight="Black" HorizontalAlignment="Center" Margin="0,60,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="Scene4" Opacity="0" CacheMode="BitmapCache">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Scene4Scale" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Border Width="1400" Height="460" CornerRadius="40" BorderThickness="3" Background="#14FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource Neon1}" Offset="0" />
                                    <GradientStop Color="{StaticResource Neon2}" Offset="0.33" />
                                    <GradientStop Color="{StaticResource Neon3}" Offset="0.66" />
                                    <GradientStop Color="{StaticResource Neon4}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="HIRE ME" Foreground="#BBFFFFFF" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="EXCEPTIONAL" Foreground="{StaticResource Cyan}" FontSize="110" FontWeight="Black" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="MOTION DESIGN" Foreground="{StaticResource Magenta}" FontSize="110" FontWeight="Black" HorizontalAlignment="Center" Margin="0,-24,0,0" />
                            <TextBlock Text="WPF • XAML • C# • 60 FPS • GPU ACCELERATED" Foreground="{StaticResource Yellow}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,32,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid VerticalAlignment="Bottom" Margin="140,0,140,88" Height="16">
                    <Border CornerRadius="10" Background="#22FFFFFF" />
                    <Border CornerRadius="10" HorizontalAlignment="Left" Width="1640" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush x:Name="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00F5FF" Offset="0" />
                                <GradientStop Color="#FF00DC" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,120,50">
                    <TextBlock Text="15s LOOP" Foreground="#AAFFFFFF" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="60 FPS" Foreground="{StaticResource Cyan}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
