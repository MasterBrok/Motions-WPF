<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ NEON NEXUS DESIGN SYSTEM ============ -->

    <!-- Core palette -->
    <Color x:Key="ColDeepBlack">#FF000000</Color>
    <Color x:Key="ColMidnight">#FF0A0E1A</Color>
    <Color x:Key="ColDarkNavy">#FF0D1526</Color>
    <Color x:Key="ColCyan">#FF00E5FF</Color>
    <Color x:Key="ColUltraviolet">#FF7B2FFF</Color>
    <Color x:Key="ColMagenta">#FFFF007A</Color>
    <Color x:Key="ColPurple">#FFA855F7</Color>
    <Color x:Key="ColCyanDim">#FF00B8CC</Color>
    <Color x:Key="ColWarmWhite">#FFF0F4FF</Color>
    <Color x:Key="ColWhite">#FFFFFFFF</Color>
    <Color x:Key="ColGrid">#FF1A2A40</Color>

    <!-- Solid brushes -->
    <SolidColorBrush x:Key="BrushBlack" Color="{StaticResource ColDeepBlack}"/>
    <SolidColorBrush x:Key="BrushMidnight" Color="{StaticResource ColMidnight}"/>
    <SolidColorBrush x:Key="BrushDarkNavy" Color="{StaticResource ColDarkNavy}"/>
    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource ColCyan}"/>
    <SolidColorBrush x:Key="BrushUltraviolet" Color="{StaticResource ColUltraviolet}"/>
    <SolidColorBrush x:Key="BrushMagenta" Color="{StaticResource ColMagenta}"/>
    <SolidColorBrush x:Key="BrushPurple" Color="{StaticResource ColPurple}"/>
    <SolidColorBrush x:Key="BrushCyanDim" Color="{StaticResource ColCyanDim}"/>
    <SolidColorBrush x:Key="BrushWarmWhite" Color="{StaticResource ColWarmWhite}"/>
    <SolidColorBrush x:Key="BrushWhite" Color="{StaticResource ColWhite}"/>
    <SolidColorBrush x:Key="BrushGrid" Color="{StaticResource ColGrid}"/>

    <!-- Glow gradients (frozen automatically by WPF for immutable resources) -->
    <RadialGradientBrush x:Key="BrushCoreGlow" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#FF00E5FF" Offset="0"/>
        <GradientStop Color="#5500E5FF" Offset="0.35"/>
        <GradientStop Color="#0000E5FF" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BrushMagentaGlow" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#FFFF007A" Offset="0"/>
        <GradientStop Color="#55FF007A" Offset="0.4"/>
        <GradientStop Color="#00FF007A" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BrushPurpleGlow" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#FFA855F7" Offset="0"/>
        <GradientStop Color="#55A855F7" Offset="0.4"/>
        <GradientStop Color="#00A855F7" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BrushVignette" Center="0.5,0.42" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#FF101830" Offset="0"/>
        <GradientStop Color="#FF060912" Offset="0.65"/>
        <GradientStop Color="#FF000000" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="BrushHairlineCyan" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#0000E5FF" Offset="0"/>
        <GradientStop Color="#FF00E5FF" Offset="0.5"/>
        <GradientStop Color="#0000E5FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushHairlineMagenta" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00FF007A" Offset="0"/>
        <GradientStop Color="#FFFF007A" Offset="0.5"/>
        <GradientStop Color="#00FF007A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCyanBeam" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#0000E5FF" Offset="0"/>
        <GradientStop Color="#6600E5FF" Offset="0.5"/>
        <GradientStop Color="#0000E5FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPanelCyan" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E000E5FF" Offset="0"/>
        <GradientStop Color="#6600E5FF" Offset="0.6"/>
        <GradientStop Color="#2200E5FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPanelMagenta" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E0FF007A" Offset="0"/>
        <GradientStop Color="#66FF007A" Offset="0.6"/>
        <GradientStop Color="#22FF007A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPanelUltraviolet" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E07B2FFF" Offset="0"/>
        <GradientStop Color="#667B2FFF" Offset="0.6"/>
        <GradientStop Color="#227B2FFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Fonts -->
    <FontFamily x:Key="FontPrimary">Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Consolas</FontFamily>

    <!-- Text styles -->
    <Style x:Key="StyleHeadline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushWarmWhite}"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StyleMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource BrushCyanDim}"/>
        <Setter Property="Opacity" Value="0.75"/>
    </Style>

    <Style x:Key="StyleTech" TargetType="TextBlock" BasedOn="{StaticResource StyleMono}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <!-- Easings -->
    <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseInOutCubic" EasingMode="EaseInOut"/>
    <QuarticEase x:Key="EaseOutQuart" EasingMode="EaseOut"/>
    <QuarticEase x:Key="EaseInQuart" EasingMode="EaseIn"/>
    <QuinticEase x:Key="EaseOutQuint" EasingMode="EaseOut"/>
    <BackEase x:Key="EaseOutBack" EasingMode="EaseOut" Amplitude="0.35"/>
    <SineEase x:Key="EaseInOutSine" EasingMode="EaseInOut"/>
    <ExponentialEase x:Key="EaseOutExpo" EasingMode="EaseOut" Exponent="6"/>

</ResourceDictionary>
