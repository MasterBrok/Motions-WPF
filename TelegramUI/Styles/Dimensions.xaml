<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing -->
    <system:Double x:Key="Space2" xmlns:system="clr-namespace:System;assembly=mscorlib">2</system:Double>
    <system:Double x:Key="Space4" xmlns:system="clr-namespace:System;assembly=mscorlib">4</system:Double>
    <system:Double x:Key="Space6" xmlns:system="clr-namespace:System;assembly=mscorlib">6</system:Double>
    <system:Double x:Key="Space8" xmlns:system="clr-namespace:System;assembly=mscorlib">8</system:Double>
    <system:Double x:Key="Space10" xmlns:system="clr-namespace:System;assembly=mscorlib">10</system:Double>
    <system:Double x:Key="Space12" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="Space16" xmlns:system="clr-namespace:System;assembly=mscorlib">16</system:Double>
    <system:Double x:Key="Space20" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>
    <system:Double x:Key="Space24" xmlns:system="clr-namespace:System;assembly=mscorlib">24</system:Double>
    <system:Double x:Key="Space32" xmlns:system="clr-namespace:System;assembly=mscorlib">32</system:Double>

    <!-- Corner Radii -->
    <CornerRadius x:Key="Radius4">4</CornerRadius>
    <CornerRadius x:Key="Radius6">6</CornerRadius>
    <CornerRadius x:Key="Radius8">8</CornerRadius>
    <CornerRadius x:Key="Radius10">10</CornerRadius>
    <CornerRadius x:Key="Radius12">12</CornerRadius>
    <CornerRadius x:Key="Radius16">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- Component Sizes -->
    <system:Double x:Key="SidebarWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">72</system:Double>
    <system:Double x:Key="ChatListWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">360</system:Double>
    <system:Double x:Key="AvatarSizeSmall" xmlns:system="clr-namespace:System;assembly=mscorlib">32</system:Double>
    <system:Double x:Key="AvatarSizeMedium" xmlns:system="clr-namespace:System;assembly=mscorlib">40</system:Double>
    <system:Double x:Key="AvatarSizeLarge" xmlns:system="clr-namespace:System;assembly=mscorlib">48</system:Double>
    <system:Double x:Key="IconSizeSmall" xmlns:system="clr-namespace:System;assembly=mscorlib">16</system:Double>
    <system:Double x:Key="IconSizeMedium" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>
    <system:Double x:Key="IconSizeLarge" xmlns:system="clr-namespace:System;assembly=mscorlib">24</system:Double>

    <!-- Shadows -->
    <DropShadowEffect x:Key="ElevationLow" 
                      BlurRadius="8" 
                      ShadowDepth="2" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0.15"/>
    
    <DropShadowEffect x:Key="ElevationMedium" 
                      BlurRadius="16" 
                      ShadowDepth="4" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0.20"/>
    
    <DropShadowEffect x:Key="ElevationHigh" 
                      BlurRadius="24" 
                      ShadowDepth="8" 
                      Direction="270" 
                      Color="#000000" 
                      Opacity="0.25"/>

</ResourceDictionary>
