<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Animation Durations -->
    <Duration x:Key="DurationMicro">0:0:0.12</Duration>
    <Duration x:Key="DurationShort">0:0:0.18</Duration>
    <Duration x:Key="DurationMedium">0:0:0.28</Duration>
    <Duration x:Key="DurationLong">0:0:0.45</Duration>
    <Duration x:Key="DurationHover">0:0:0.22</Duration>

    <!-- Easing Functions -->
    <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut"/>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseIn" EasingMode="EaseIn"/>
    <QuadraticEase x:Key="QuadEaseOut" EasingMode="EaseOut"/>
    <QuadraticEase x:Key="QuadEaseInOut" EasingMode="EaseInOut"/>
    <BackEase x:Key="EaseBackOut" EasingMode="EaseOut" Amplitude="0.35"/>
    <ExponentialEase x:Key="EaseExpoOut" EasingMode="EaseOut" Exponent="7"/>

    <!-- Loading spinner storyboard: target RotateTransform by name on consumer -->
    <Storyboard x:Key="SpinnerStoryboard" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                         Storyboard.TargetProperty="Angle"
                         From="0" To="360"
                         Duration="0:0:0.9"/>
    </Storyboard>

</ResourceDictionary>
