<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Styles/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource DarkAppBackground}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource DarkSidebarBackground}"/>
    <SolidColorBrush x:Key="ChatListBackgroundBrush" Color="{StaticResource DarkChatListBackground}"/>
    <SolidColorBrush x:Key="ConversationBackgroundBrush" Color="{StaticResource DarkConversationBackground}"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource DarkElevatedSurface}"/>
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource DarkHoverSurface}"/>
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="{StaticResource DarkSelectedSurface}"/>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource DarkPrimaryAccent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource DarkAccentHover}"/>
    <SolidColorBrush x:Key="IncomingBubbleBrush" Color="{StaticResource DarkIncomingBubble}"/>
    <SolidColorBrush x:Key="OutgoingBubbleBrush" Color="{StaticResource DarkOutgoingBubble}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource DarkPrimaryText}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource DarkSecondaryText}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource DarkMutedText}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DarkDivider}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource DarkSuccess}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource DarkWarning}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource DarkError}"/>
    <SolidColorBrush x:Key="ReplyHighlightBrush" Color="#3355A0E0"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="IncomingMetaBrush" Color="#7A8FA6"/>
    <SolidColorBrush x:Key="OutgoingMetaBrush" Color="#A8C5E8"/>
    <SolidColorBrush x:Key="IncomingTextBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="OutgoingTextBrush" Color="#F3F5F8"/>

</ResourceDictionary>
