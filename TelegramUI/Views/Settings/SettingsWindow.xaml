<Window x:Class="TelegramUI.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="480"
        Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Border Background="{DynamicResource ChatListBackgroundBrush}"
            CornerRadius="{StaticResource Radius12}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="20,18,12,0">
                <TextBlock Text="Settings"
                           FontSize="18"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Button Style="{StaticResource IconButtonStyle}"
                        Click="Close_Click"
                        ToolTip="Close"
                        HorizontalAlignment="Right">
                    <Path Data="{StaticResource IconClose}"
                          Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"
                          Width="14" Height="14" Stretch="Uniform"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="20,16,20,20">
                <!-- Appearance section -->
                <TextBlock Text="Appearance"
                           FontSize="12"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="4,0,0,10"/>

                <Border Background="{DynamicResource ConversationBackgroundBrush}"
                        CornerRadius="{StaticResource Radius10}"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Theme"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Switch between dark and light"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <RadioButton x:Name="ThemeToggle"
                                     Grid.Column="1"
                                     Style="{StaticResource ToggleSwitchStyle}"
                                     VerticalAlignment="Center"
                                     Checked="ThemeToggle_Changed"
                                     Unchecked="ThemeToggle_Changed"/>
                    </Grid>
                </Border>

                <!-- Behavior -->
                <TextBlock Text="Behavior"
                           FontSize="12"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="4,20,0,10"/>

                <Border Background="{DynamicResource ConversationBackgroundBrush}"
                        CornerRadius="{StaticResource Radius10}"
                        Padding="14,10"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Reduced motion"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Disable animations for accessibility"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <RadioButton x:Name="MotionToggle"
                                     Grid.Column="1"
                                     Style="{StaticResource ToggleSwitchStyle}"
                                     VerticalAlignment="Center"
                                     Checked="MotionToggle_Changed"
                                     Unchecked="MotionToggle_Changed"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource ConversationBackgroundBrush}"
                        CornerRadius="{StaticResource Radius10}"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mock incoming messages"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <RadioButton x:Name="MockTimerToggle"
                                     Grid.Column="1"
                                     Style="{StaticResource ToggleSwitchStyle}"
                                     IsChecked="True"
                                     VerticalAlignment="Center"
                                     Checked="MockTimer_Changed"
                                     Unchecked="MockTimer_Changed"/>
                    </Grid>
                </Border>

                <!-- About -->
                <TextBlock Text="About"
                           FontSize="12"
                           FontWeight="{StaticResource FontWeightSemiBold}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="4,20,0,10"/>

                <Border Background="{DynamicResource ConversationBackgroundBrush}"
                        CornerRadius="{StaticResource Radius10}"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="TelegramUI — Premium WPF Experience"
                                   FontSize="14"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Prototype build · Mock data · No backend"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,3,0,0"/>
                        <TextBlock Text="Prototype features: media rendering, voice playback, stickers and GIFs are visual placeholders."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
