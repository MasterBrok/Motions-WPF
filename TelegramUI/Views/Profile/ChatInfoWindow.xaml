<Window x:Class="TelegramUI.Views.Profile.ChatInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Info"
        Height="560"
        Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Border Background="{DynamicResource ChatListBackgroundBrush}"
            CornerRadius="{StaticResource Radius12}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Close button -->
            <Button Grid.Row="0"
                    Style="{StaticResource IconButtonStyle}"
                    Click="Close_Click"
                    ToolTip="Close"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,10,0"
                    Panel.ZIndex="10">
                <Path Data="{StaticResource IconClose}"
                      Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"
                      Width="14" Height="14" Stretch="Uniform"/>
            </Button>

            <StackPanel Grid.Row="0">
                <!-- Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,32,0,0">
                    <Border Width="96" Height="96"
                            Background="{DynamicResource PrimaryAccentBrush}"
                            CornerRadius="{StaticResource RadiusFull}">
                        <TextBlock x:Name="AvatarInitials"
                                   FontSize="32"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{DynamicResource OnAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="InfoTitle"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"
                               FontSize="18"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock x:Name="InfoSubtitle"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Action row -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Height="56" Width="72"
                            Click="Notify_Click">
                        <StackPanel>
                            <Path Data="{StaticResource IconMute}"
                                  Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"
                                  Width="20" Height="20" Stretch="Uniform"
                                  HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NotifyLabel"
                                       Text="Muted"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Height="56" Width="72"
                            ToolTip="Search in chat"
                            Click="SearchInChat_Click">
                        <StackPanel>
                            <Path Data="{StaticResource IconSearch}"
                                  Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"
                                  Width="20" Height="20" Stretch="Uniform"
                                  HorizontalAlignment="Center"/>
                            <TextBlock Text="Search"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Tabs -->
                <Border Margin="20,20,20,0"
                        Background="{DynamicResource ConversationBackgroundBrush}"
                        CornerRadius="{StaticResource Radius8}"
                        Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton Grid.Column="0" Content="Info"
                                     GroupName="InfoTabs" IsChecked="True"
                                     Style="{StaticResource FilterTabStyle}"
                                     HorizontalContentAlignment="Center"
                                     Checked="Tab_Checked"/>
                        <RadioButton Grid.Column="1" Content="Media"
                                     GroupName="InfoTabs"
                                     Style="{StaticResource FilterTabStyle}"
                                     HorizontalContentAlignment="Center"
                                     Checked="Tab_Checked"/>
                        <RadioButton Grid.Column="2" Content="Members"
                                     GroupName="InfoTabs"
                                     Style="{StaticResource FilterTabStyle}"
                                     HorizontalContentAlignment="Center"
                                     Checked="Tab_Checked"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Tab content -->
            <Grid Grid.Row="1" Margin="20,16,20,20">
                <!-- Info tab -->
                <StackPanel x:Name="InfoTab" x:FieldModifier="private">
                    <ItemsControl x:Name="InfoRows"/>
                </StackPanel>

                <!-- Media tab -->
                <ScrollViewer x:Name="MediaTab"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="MediaGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Members tab -->
                <ScrollViewer x:Name="MembersTab"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="MembersList"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
