<Window x:Class="TelegramUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:TelegramUI.Behaviors"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Telegram"
        Height="800"
        Width="1400"
        MinHeight="600"
        MinWidth="1000"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ContextMenu x:Key="MessageContextMenu" Style="{StaticResource ChatContextMenuStyle}">
            <MenuItem Header="Reply"
                      Style="{StaticResource MenuItemStyle}"
                      Click="MenuMessageReply_Click"/>
            <MenuItem Header="Copy Text"
                      Style="{StaticResource MenuItemStyle}"
                      Click="MenuMessageCopy_Click"/>
            <MenuItem Header="Delete"
                      Style="{StaticResource MenuItemStyle}"
                      Click="MenuMessageDelete_Click"/>
        </ContextMenu>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            CaptionHeight="40"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0">
                        <Path Data="{StaticResource IconSend}"
                              Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.5"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="Telegram"
                                   FontSize="{StaticResource FontSize13}"
                                   FontWeight="{StaticResource FontWeightMedium}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton"
                                Width="46" Height="40"
                                Click="MinimizeButton_Click"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="Minimize">
                            <Path Data="{StaticResource IconMinimize}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="MaximizeButton"
                                Width="46" Height="40"
                                Click="MaximizeButton_Click"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="Maximize">
                            <Path x:Name="MaximizeIcon"
                                  Data="{StaticResource IconMaximize}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>

                        <Button Width="46" Height="40"
                                Click="CloseButton_Click"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                ToolTip="Close">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <Border Grid.Row="0"
                                Width="40" Height="40"
                                Background="{DynamicResource PrimaryAccentBrush}"
                                CornerRadius="{StaticResource RadiusFull}"
                                Margin="16,12,16,8">
                            <Path Data="{StaticResource IconSend}"
                                  Stroke="White" StrokeThickness="1.5"
                                  Width="18" Height="18"
                                  Stretch="Uniform"/>
                        </Border>

                        <!-- Nav Buttons -->
                        <StackPanel Grid.Row="1">
                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         GroupName="Nav"
                                         Tag="Chats" IsChecked="True"
                                         Click="Nav_Click" ToolTip="Chats">
                                <Path Data="{StaticResource IconChat}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" StrokeThickness="1.5"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         GroupName="Nav"
                                         Tag="Contacts"
                                         Click="Nav_Click" ToolTip="Contacts">
                                <Path Data="{StaticResource IconContacts}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" StrokeThickness="1.5"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         GroupName="Nav"
                                         Tag="Calls"
                                         Click="Nav_Click" ToolTip="Calls">
                                <Path Data="{StaticResource IconCalls}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" StrokeThickness="1.5"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         GroupName="Nav"
                                         Tag="Saved"
                                         Click="Nav_Click" ToolTip="Saved Messages">
                                <Path Data="{StaticResource IconSaved}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" StrokeThickness="1.5"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding ToggleThemeCommand}"
                                    ToolTip="Toggle Theme">
                                <Path x:Name="ThemeIcon"
                                      Data="{StaticResource IconSmile}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5"
                                      Width="22" Height="22" Stretch="Uniform"/>
                            </Button>

                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    ToolTip="Settings"
                                    Click="SettingsButton_Click">
                                <Grid Width="22" Height="22">
                                    <Path Data="{StaticResource IconSettingsRing}"
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5"
                                          Stretch="Uniform"/>
                                    <Path Data="{StaticResource IconSettings}"
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5"
                                          Width="9" Height="9"
                                          Stretch="Uniform"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Chat List Panel -->
                <Border Grid.Column="1"
                        Background="{DynamicResource ChatListBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search -->
                        <Border Grid.Row="0" Margin="12,12,12,8">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBoxStyle}"
                                     Text="{Binding ChatListViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="SearchBox_KeyDown"/>
                        </Border>

                        <!-- Filter Tabs (chats view only) -->
                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding ChatListViewModel.FilterTabs}"
                                      Margin="12,0,12,8"
                                      Visibility="{Binding IsChatsView, Converter={StaticResource BoolToVisConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding}"
                                                 GroupName="FilterTabs"
                                                 Style="{StaticResource FilterTabStyle}"
                                                 Click="FilterTab_Click"
                                                 Tag="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Panel title (other views) -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding CurrentView}"
                                   FontSize="20"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="20,4,0,10"
                                   Visibility="{Binding IsChatsView, Converter={StaticResource InverseBoolToVisConverter}}"/>

                        <!-- View host: one control, template switches per view -->
                <ContentControl Grid.Row="2"
                                x:Name="ViewHost"
                                Focusable="False">
                    <ContentControl.Resources>
                        <DataTemplate x:Key="ChatsViewTemplate">
                            <ListBox x:Name="ChatListBox"
                                     ItemsSource="{Binding ChatListViewModel.FilteredChats}"
                                     SelectedItem="{Binding ChatListViewModel.SelectedChat}"
                                     SelectionChanged="ChatListBox_SelectionChanged"
                                     Style="{StaticResource ChatListBoxStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     b:DragDropBehavior.EnableChatReorder="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,8"
                                              Background="Transparent"
                                              ContextMenu="{StaticResource ChatContextMenu}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                                <Border Width="48" Height="48"
                                                        Background="{DynamicResource PrimaryAccentBrush}"
                                                        CornerRadius="{StaticResource RadiusFull}">
                                                    <TextBlock Text="{Binding Title, Converter={StaticResource InitialsConverter}}"
                                                               FontSize="{StaticResource FontSize16}"
                                                               FontWeight="{StaticResource FontWeightMedium}"
                                                               Foreground="{DynamicResource OnAccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{DynamicResource SuccessBrush}"
                                                         Stroke="{DynamicResource ChatListBackgroundBrush}"
                                                         StrokeThickness="2"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom">
                                                    <Ellipse.Visibility>
                                                        <Binding Path="IsOnline">
                                                            <Binding.Converter>
                                                                <BooleanToVisibilityConverter/>
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                            </Grid>

                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource ConversationNameStyle}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <Path Data="{StaticResource IconVerified}"
                                                          Stroke="{DynamicResource PrimaryAccentBrush}" StrokeThickness="1.5"
                                                          Width="14" Height="14"
                                                          Stretch="Uniform"
                                                          Margin="4,1,0,0"
                                                          VerticalAlignment="Center">
                                                        <Path.Visibility>
                                                            <Binding Path="IsVerified">
                                                                <Binding.Converter>
                                                                    <BooleanToVisibilityConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Path.Visibility>
                                                    </Path>
                                                    <Path Data="{StaticResource IconMute}"
                                                          Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          Margin="4,1,0,0"
                                                          VerticalAlignment="Center">
                                                        <Path.Visibility>
                                                            <Binding Path="IsMuted">
                                                                <Binding.Converter>
                                                                    <BooleanToVisibilityConverter/>
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </Path.Visibility>
                                                    </Path>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1"
                                                           Margin="0,3,0,0"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding LastMessage.Content, Mode=OneWay, TargetNullValue='No messages yet'}"/>
                                            </Grid>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Right"
                                                        Margin="8,2,0,0">
                                                <TextBlock Text="{Binding LastActivity, Converter={StaticResource TimeConverter}}"
                                                           Style="{StaticResource TimestampStyle}"
                                                           Foreground="{DynamicResource MutedTextBrush}"/>

                                                <Border Background="{DynamicResource PrimaryAccentBrush}"
                                                        CornerRadius="{StaticResource RadiusFull}"
                                                        Padding="6,2"
                                                        Margin="0,6,0,0"
                                                        HorizontalAlignment="Right">
                                                    <Border.Visibility>
                                                        <Binding Path="UnreadCount" Converter="{StaticResource UnreadVisibilityConverter}"/>
                                                    </Border.Visibility>
                                                    <TextBlock Text="{Binding UnreadCount}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource OnAccentBrush}"
                                                               FontWeight="{StaticResource FontWeightSemiBold}"/>
                                                </Border>

                                                <Path Data="{StaticResource IconPin}"
                                                      Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform"
                                                      Margin="0,6,0,0"
                                                      HorizontalAlignment="Right">
                                                    <Path.Visibility>
                                                        <Binding Path="IsPinned">
                                                            <Binding.Converter>
                                                                <BooleanToVisibilityConverter/>
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </Path.Visibility>
                                                </Path>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DataTemplate>

                        <DataTemplate x:Key="ContactsViewTemplate">
                            <ListBox ItemsSource="{Binding ChatListViewModel.Contacts}"
                                     Style="{StaticResource ChatListBoxStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42"
                                                    Background="{DynamicResource PrimaryAccentBrush}"
                                                    CornerRadius="{StaticResource RadiusFull}"
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                                           FontSize="14"
                                                           FontWeight="{StaticResource FontWeightMedium}"
                                                           Foreground="{DynamicResource OnAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}"
                                                           Style="{StaticResource ConversationNameStyle}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding Username}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DataTemplate>

                        <DataTemplate x:Key="CallsViewTemplate">
                            <ListBox ItemsSource="{Binding ChatListViewModel.Calls}"
                                     Style="{StaticResource ChatListBoxStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42"
                                                    Background="{DynamicResource HoverSurfaceBrush}"
                                                    CornerRadius="{StaticResource RadiusFull}"
                                                    Margin="0,0,12,0">
                                                <Path Data="{StaticResource IconCalls}"
                                                      Stroke="{Binding IsMissed, Converter={StaticResource CallColorConverter}}" StrokeThickness="1.5"
                                                      Width="18" Height="18" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Grid.Column="1">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource ConversationNameStyle}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock FontSize="12" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Outgoing"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsIncoming}" Value="True">
                                                                    <Setter Property="Text" Value="Incoming"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMissed}" Value="True">
                                                                    <Setter Property="Text" Value="Missed"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Time, Converter={StaticResource TimeConverter}}"
                                                       FontSize="11"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DataTemplate>

                        <DataTemplate x:Key="SavedViewTemplate">
                            <ListBox ItemsSource="{Binding ChatListViewModel.SavedMessages}"
                                     Style="{StaticResource ChatListBoxStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource IncomingBubbleBrush}"
                                                CornerRadius="{StaticResource Radius10}"
                                                Padding="12,8"
                                                Margin="12,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Content}"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:MMM dd, HH:mm}'}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>
        </Border>

        <!-- Conversation Area -->
                <Border Grid.Column="2"
                        Background="{DynamicResource ConversationBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Conversation Header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource ChatListBackgroundBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                Height="60">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="HeaderInfo_Click">
                                    <Border Width="40" Height="40"
                                            Background="{DynamicResource PrimaryAccentBrush}"
                                            CornerRadius="{StaticResource RadiusFull}"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="{Binding ConversationViewModel.CurrentChat.Title, Converter={StaticResource InitialsConverter}}"
                                                   FontSize="{StaticResource FontSize14}"
                                                   FontWeight="{StaticResource FontWeightMedium}"
                                                   Foreground="{DynamicResource OnAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ConversationViewModel.CurrentChat.Title}"
                                                   Style="{StaticResource ConversationNameStyle}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="last seen recently"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConversationViewModel.CurrentChat.IsOnline}" Value="True">
                                                            <Setter Property="Text" Value="online"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConversationViewModel.IsTyping}" Value="True">
                                                            <Setter Property="Text" Value="typing..."/>
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="Search in Chat" Click="SearchInChatButton_Click">
                                        <Path Data="{StaticResource IconSearch}"
                                              Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"
                                              Width="18" Height="18" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="More">
                                        <Path Data="{StaticResource IconMore}"
                                              Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"
                                              Width="18" Height="18" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Messages -->
                        <Grid Grid.Row="1">
                            <ListBox x:Name="MessagesControl"
                                 ItemsSource="{Binding ConversationViewModel.Messages}"
                                 Style="{StaticResource ChatListBoxStyle}"
                                 Background="Transparent"
                                 Padding="24,16"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 Focusable="False"
                                 SelectionMode="Single"
                                 PreviewMouseWheel="Messages_PreviewMouseWheel">
                            <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2"
                                              Background="Transparent"
                                              MouseEnter="Message_MouseEnter"
                                              MouseLeave="Message_MouseLeave"
                                              ContextMenu="{StaticResource MessageContextMenu}"
                                              Tag="{Binding}">
                                            <Grid.RenderTransform>
                                                <TranslateTransform x:Name="MsgTranslate" Y="8"/>
                                            </Grid.RenderTransform>
                                            <Grid.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="MsgTranslate"
                                                                             Storyboard.TargetProperty="Y"
                                                                             From="8" To="0"
                                                                             Duration="0:0:0.22">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Grid.Triggers>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Bubble -->
                                            <Border CornerRadius="12"
                                                    Padding="12,8"
                                                    MaxWidth="520"
                                                    HorizontalAlignment="{Binding IsOutgoing, Converter={StaticResource MessageAlignmentConverter}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource IncomingBubbleBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource OutgoingBubbleBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <!-- Sender name in groups -->
                                                    <TextBlock FontSize="12"
                                                               FontWeight="{StaticResource FontWeightSemiBold}"
                                                               Foreground="{DynamicResource PrimaryAccentBrush}"
                                                               Margin="0,0,0,2"
                                                               Text="{Binding Sender.FullName}">
                                                        <TextBlock.Visibility>
                                                            <Binding Path="Sender" Converter="{StaticResource NullToVisibilityConverter}"/>
                                                        </TextBlock.Visibility>
                                                    </TextBlock>

                                                    <!-- Reply reference -->
                                                    <Border CornerRadius="6"
                                                            Padding="8,4"
                                                            Margin="0,0,0,4"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="ReplyReference_Click"
                                                            Tag="{Binding ReplyTo}"
                                                            Background="{DynamicResource ReplyHighlightBrush}">
                                                        <Border.Visibility>
                                                            <Binding Path="ReplyTo" Converter="{StaticResource NullToVisibilityConverter}"/>
                                                        </Border.Visibility>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ReplyTo.Sender.FullName}"
                                                                       FontSize="11"
                                                                       FontWeight="{StaticResource FontWeightSemiBold}"
                                                                       Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                                            <TextBlock Text="{Binding ReplyTo.Content}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource IncomingMetaBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Content by type -->
                                                    <Grid>
                                                        <!-- Image message -->
                                                        <Border CornerRadius="8"
                                                                Height="180"
                                                                Background="{DynamicResource HoverSurfaceBrush}">
                                                            <Border.Visibility>
                                                                <Binding Path="Type" Converter="{StaticResource MessageTypeVisibilityConverter}" ConverterParameter="Image"/>
                                                            </Border.Visibility>
                                                            <Grid>
                                                                <TextBlock Text="🖼️" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Photo" FontSize="11"
                                                                           Foreground="{DynamicResource IncomingMetaBrush}"
                                                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                           Margin="10,0,0,8"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- File message -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Visibility>
                                                                <Binding Path="Type" Converter="{StaticResource MessageTypeVisibilityConverter}" ConverterParameter="File"/>
                                                            </StackPanel.Visibility>
                                                            <Border Width="40" Height="40"
                                                                    Background="{DynamicResource ReplyHighlightBrush}"
                                                                    CornerRadius="{StaticResource RadiusFull}">
                                                                <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Attachment.FileName, FallbackValue='Document.pdf'}"
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                                                <TextBlock Text="Download" FontSize="11"
                                                                           Foreground="{DynamicResource IncomingMetaBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Voice message -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Visibility>
                                                                <Binding Path="Type" Converter="{StaticResource MessageTypeVisibilityConverter}" ConverterParameter="Voice"/>
                                                            </StackPanel.Visibility>
                                                            <Border Width="32" Height="32"
                                                                    Background="{DynamicResource PrimaryAccentBrush}"
                                                                    CornerRadius="{StaticResource RadiusFull}">
                                                                <Path Data="{StaticResource IconMic}" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                                                            </Border>
                                                            <TextBlock Text="Voice message" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Text message (default) -->
                                                        <TextBlock Text="{Binding Content}"
                                                                   FontSize="14"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource IncomingTextBrush}"/>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="Text">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>


                                                    <!-- Reactions -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <ItemsControl ItemsSource="{Binding Reactions}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource ReplyHighlightBrush}"
                                                                            CornerRadius="{StaticResource RadiusFull}"
                                                                            Padding="6,2"
                                                                            Margin="0,0,4,0"
                                                                            Cursor="Hand"
                                                                            MouseLeftButtonDown="ReactionChip_Click">                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Emoji}" FontSize="11"/>
                                                                            <TextBlock Text="{Binding Count}" FontSize="11" Margin="3,0,0,0"
                                                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right"
                                                                Margin="0,4,0,0">
                                                        <TextBlock Text="edited"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource IncomingMetaBrush}"
                                                                   Margin="0,0,4,0">
                                                            <TextBlock.Visibility>
                                                                <Binding Path="IsEdited">
                                                                    <Binding.Converter>
                                                                        <BooleanToVisibilityConverter/>
                                                                    </Binding.Converter>
                                                                </Binding>
                                                            </TextBlock.Visibility>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource IncomingMetaBrush}"/>
                                                        <!-- Status ticks -->
                                                        <Path Data="{StaticResource IconCheck}"
                                                              Stroke="{DynamicResource IncomingMetaBrush}" StrokeThickness="1.5"
                                                              Width="13" Height="13"
                                                              Stretch="Uniform"
                                                              Margin="3,0,0,0"
                                                              VerticalAlignment="Center">
                                                            <Path.Visibility>
                                                                <Binding Path="IsOutgoing">
                                                                    <Binding.Converter>
                                                                        <BooleanToVisibilityConverter/>
                                                                    </Binding.Converter>
                                                                </Binding>
                                                            </Path.Visibility>
                                                        </Path>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Hover toolbar (overlay, no layout shift) -->
                                            <Border x:Name="MessageToolbar"
                                                    Background="{DynamicResource ElevatedSurfaceBrush}"
                                                    CornerRadius="{StaticResource Radius8}"
                                                    Padding="4"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="{Binding IsOutgoing, Converter={StaticResource ToolbarAlignmentConverter}}"
                                                    Margin="8,0">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                                                </Border.Effect>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="Reply" Click="ToolbarReply_Click" Tag="{Binding}">
                                                        <Path Data="{StaticResource IconReply}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="React 👍" Click="ToolbarReact_Click" Tag="{Binding}">
                                                        <TextBlock Text="👍" FontSize="13"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="React ❤️" Click="ToolbarReactHeart_Click" Tag="{Binding}">
                                                        <TextBlock Text="❤️" FontSize="13"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="Copy" Click="ToolbarCopy_Click" Tag="{Binding}">
                                                        <Path Data="{StaticResource IconCopy}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="Delete" Click="ToolbarDelete_Click" Tag="{Binding}">
                                                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Loading older messages indicator (top) -->
                            <Border x:Name="LoadingOlderBar"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,12,0,0"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <ContentControl ContentTemplate="{StaticResource LoadingPill}"/>
                            </Border>

                            <!-- Loading chat indicator (center) -->
                            <Border x:Name="LoadingChatOverlay"
                                    Background="{DynamicResource ConversationBackgroundBrush}"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Style="{StaticResource SpinnerStyle}" Width="32" Height="32">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotate"/>
                                        </Path.RenderTransform>
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="Path.Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource SpinnerStoryboard}"/>
                                            </EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                    <TextBlock Text="Loading chat..."
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Empty state overlay -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource ConversationBackgroundBrush}"
                                Visibility="Collapsed"
                                x:Name="EmptyState">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconChat}"
                                      Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5"
                                      Width="48" Height="48"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Opacity="0.4"/>
                                <TextBlock Text="No messages yet"
                                           FontSize="15"
                                           FontWeight="{StaticResource FontWeightMedium}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,0"/>
                                <TextBlock Text="Send a message to start the conversation"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"
                                           Opacity="0.7"/>
                            </StackPanel>
                        </Border>

                        <!-- Scroll to bottom button -->
                        <Button x:Name="ScrollToBottomButton"
                                Grid.Row="1"
                                Style="{StaticResource ScrollToBottomButtonStyle}"
                                Click="ScrollToBottomButton_Click"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,24,16">
                            <Path Data="{StaticResource IconArrowDown}"
                                  Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.5"
                                  Width="18" Height="18" Stretch="Uniform"/>
                        </Button>

                        <!-- Composer -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource ChatListBackgroundBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="16,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Reply preview bar -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource HoverSurfaceBrush}"
                                        CornerRadius="{StaticResource Radius8}"
                                        Padding="10,6"
                                        Margin="0,0,0,8"
                                        Visibility="{Binding ConversationViewModel.ReplyingTo, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ConversationViewModel.ReplyingTo.Sender.FullName}"
                                                       FontSize="11"
                                                       FontWeight="{StaticResource FontWeightSemiBold}"
                                                       Foreground="{DynamicResource PrimaryAccentBrush}"/>
                                            <TextBlock Text="{Binding ConversationViewModel.ReplyingTo.Content}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding CancelReplyCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Input row -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="AttachButton"
                                            Grid.Column="0"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Attachment"
                                            Click="AttachButton_Click">
                                        <Path Data="{StaticResource IconAttach}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform"/>
                                    </Button>

                                    <Popup x:Name="AttachPopup"
                                           PlacementTarget="{Binding ElementName=AttachButton}"
                                           Placement="Top"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Radius12}"
                                                Margin="8"
                                                Padding="8">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <MenuItem Header="Photo or Video" Style="{StaticResource MenuItemStyle}" Click="AttachPhoto_Click"/>
                                                <MenuItem Header="File" Style="{StaticResource MenuItemStyle}" Click="AttachFile_Click"/>
                                                <MenuItem Header="Contact" Style="{StaticResource MenuItemStyle}" Click="AttachContact_Click"/>
                                                <MenuItem Header="Location" Style="{StaticResource MenuItemStyle}" Click="AttachLocation_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource ConversationBackgroundBrush}"
                                            CornerRadius="{StaticResource Radius10}"
                                            Margin="8,0"
                                            Padding="12,9">
                                        <TextBox x:Name="MessageInput"
                                                 Text="{Binding ConversationViewModel.MessageText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MessageInputStyle}"
                                                 KeyDown="MessageInput_KeyDown"
                                                 AcceptsReturn="False"/>
                                    </Border>

                                    <Button x:Name="EmojiButton"
                                            Grid.Column="2"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Emoji"
                                            Click="EmojiButton_Click">
                                        <Path Data="{StaticResource IconSmile}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform"/>
                                    </Button>

                                    <Popup x:Name="EmojiPopup"
                                           PlacementTarget="{Binding ElementName=EmojiButton}"
                                           Placement="Top"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Radius12}"
                                                Width="320" Height="320"
                                                Margin="8">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35"/>
                                            </Border.Effect>
                                            <Grid Margin="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBox Grid.Row="0"
                                                         x:Name="EmojiSearchBox"
                                                         Style="{StaticResource SearchBoxStyle}"
                                                         Margin="0,0,0,8"/>

                                                <ListBox Grid.Row="1"
                                                         x:Name="EmojiList"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         SelectionChanged="EmojiList_SelectionChanged">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="8"/>
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                </ListBox>
                                            </Grid>
                                        </Border>
                                    </Popup>

                                    <Button Grid.Column="3"
                                            Style="{StaticResource SendButtonStyle}"
                                            Width="40" Height="40"
                                            Margin="8,0,0,0"
                                            Command="{Binding SendMessageCommand}">
                                        <Path Data="{StaticResource IconSend}"
                                              Stroke="White" StrokeThickness="1.5"
                                              Width="18" Height="18" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

