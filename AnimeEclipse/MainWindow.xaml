<Window x:Class="AnimeEclipse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anime Eclipse"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ObsidianBlack}"
        MinWidth="1280"
        MinHeight="720"
        Width="1920"
        Height="1080">
    <Grid x:Name="RootGrid">
        <!-- Render Layers -->
        <Canvas x:Name="BackgroundLayer" ClipToBounds="True"/>
        <Canvas x:Name="MidgroundLayer" ClipToBounds="True"/>
        <Canvas x:Name="ForegroundLayer" ClipToBounds="True"/>
        <Canvas x:Name="ParticleLayer" ClipToBounds="True"/>
        <Canvas x:Name="EffectLayer" ClipToBounds="True"/>
        <Canvas x:Name="TypographyLayer" ClipToBounds="True"/>

        <!-- Flash Overlay -->
        <Rectangle x:Name="FlashOverlay"
                   Fill="White"
                   Opacity="0"
                   IsHitTestVisible="False"/>

        <!-- Vignette Overlay -->
        <Rectangle x:Name="VignetteOverlay"
                   Fill="{StaticResource VignetteGradient}"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
