<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Glow Effects -->
    <DropShadowEffect x:Key="CrimsonGlow" Color="#E62748" BlurRadius="30" ShadowDepth="0" Opacity="0.9"/>
    <DropShadowEffect x:Key="VioletGlow" Color="#9A4DFF" BlurRadius="25" ShadowDepth="0" Opacity="0.85"/>
    <DropShadowEffect x:Key="SakuraGlow" Color="#FF91C8" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
    <DropShadowEffect x:Key="MoonGlow" Color="#E62748" BlurRadius="50" ShadowDepth="0" Opacity="0.6"/>
    <DropShadowEffect x:Key="SlashGlow" Color="#FFFFFF" BlurRadius="40" ShadowDepth="0" Opacity="0.9"/>
    <DropShadowEffect x:Key="IntenseGlow" Color="#DCE7FF" BlurRadius="60" ShadowDepth="0" Opacity="1"/>

    <!-- Blur Effects -->
    <BlurEffect x:Key="SoftBlur" Radius="3"/>
    <BlurEffect x:Key="MediumBlur" Radius="8"/>
    <BlurEffect x:Key="HeavyBlur" Radius="15"/>

</ResourceDictionary>
