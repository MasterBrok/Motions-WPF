<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Color Palette -->
    <Color x:Key="ObsidianBlackColor">#080812</Color>
    <Color x:Key="MidnightNavyColor">#10162D</Color>
    <Color x:Key="BloodCrimsonColor">#E62748</Color>
    <Color x:Key="ElectricVioletColor">#9A4DFF</Color>
    <Color x:Key="SakuraPinkColor">#FF91C8</Color>
    <Color x:Key="MoonlightSilverColor">#DCE7FF</Color>
    <Color x:Key="PureWhiteColor">#FFFFFF</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="ObsidianBlack" Color="{StaticResource ObsidianBlackColor}"/>
    <SolidColorBrush x:Key="MidnightNavy" Color="{StaticResource MidnightNavyColor}"/>
    <SolidColorBrush x:Key="BloodCrimson" Color="{StaticResource BloodCrimsonColor}"/>
    <SolidColorBrush x:Key="ElectricViolet" Color="{StaticResource ElectricVioletColor}"/>
    <SolidColorBrush x:Key="SakuraPink" Color="{StaticResource SakuraPinkColor}"/>
    <SolidColorBrush x:Key="MoonlightSilver" Color="{StaticResource MoonlightSilverColor}"/>
    <SolidColorBrush x:Key="PureWhite" Color="{StaticResource PureWhiteColor}"/>

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="MoonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E62748" Offset="0"/>
        <GradientStop Color="#B81D3A" Offset="0.5"/>
        <GradientStop Color="#7A0F25" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SkyGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#10162D" Offset="0"/>
        <GradientStop Color="#080812" Offset="0.6"/>
        <GradientStop Color="#040408" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SwordEnergyGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#9A4DFF" Offset="0"/>
        <GradientStop Color="#DCE7FF" Offset="0.5"/>
        <GradientStop Color="#9A4DFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SlashGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#9A4DFF" Offset="0"/>
        <GradientStop Color="#E62748" Offset="0.4"/>
        <GradientStop Color="#FF91C8" Offset="0.6"/>
        <GradientStop Color="#E62748" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="MoonGlow" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#40E62748" Offset="0.6"/>
        <GradientStop Color="#20E62748" Offset="0.8"/>
        <GradientStop Color="#00E62748" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="FlashGradient" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#80FFFFFF" Offset="0"/>
        <GradientStop Color="#40DCE7FF" Offset="0.5"/>
        <GradientStop Color="#009A4DFF" Offset="1"/>
    </RadialGradientBrush>

    <!-- Vignette -->
    <RadialGradientBrush x:Key="VignetteGradient" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#00000000" Offset="0.4"/>
        <GradientStop Color="#40000000" Offset="0.7"/>
        <GradientStop Color="#AA000000" Offset="1"/>
    </RadialGradientBrush>

</ResourceDictionary>
