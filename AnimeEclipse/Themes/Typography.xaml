<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Font Sizes -->
    <sys:Double x:Key="TitleLarge">140</sys:Double>
    <sys:Double x:Key="TitleMedium">72</sys:Double>
    <sys:Double x:Key="TitleSmall">48</sys:Double>
    <sys:Double x:Key="BodyLarge">32</sys:Double>
    <sys:Double x:Key="BodyMedium">24</sys:Double>
    <sys:Double x:Key="BodySmall">18</sys:Double>

    <!-- Base Anime Typography Style -->
    <Style x:Key="AnimeTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Yu Gothic, Meiryo, Segoe UI"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PureWhite}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{StaticResource CrimsonGlow}"/>
    </Style>

    <Style x:Key="AnimeSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Yu Gothic Light, Meiryo, Segoe UI Light"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{StaticResource MoonlightSilver}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{StaticResource VioletGlow}"/>
    </Style>

</ResourceDictionary>
