<Window x:Class="ABYSSAL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ABYSSAL - The Lost City Beneath the Ocean"
        Height="1080" Width="1920"
        WindowState="Maximized"
        Background="#080E15">

    <Window.Resources>
        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Background" Value="#0D1A25"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#152535"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#051015"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SceneButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Viewport3D x:Name="Viewport" ClipToBounds="True">
        </Viewport3D>

        <Grid x:Name="OverlayControls" VerticalAlignment="Top" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <TextBlock x:Name="TitleText"
                           Text="ABYSSAL"
                           Foreground="#FFD700"
                           FontSize="24"
                           FontFamily="Consolas"
                            FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="PlayButton" Content="PLAY" Style="{StaticResource ControlButton}" MinWidth="70"/>
                <Button x:Name="RestartButton" Content="RESTART" Style="{StaticResource ControlButton}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="SceneListPanel" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="25,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="SEQUENCES" Foreground="#FFD700" FontFamily="Consolas" FontSize="11" Margin="8,0,0,10" Opacity="0.7"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="500">
                <StackPanel>
                    <Button x:Name="Scene1Button" Content="01 - Above the Unknown" Style="{StaticResource SceneButton}"/>
                    <Button x:Name="Scene2Button" Content="02 - Descent into the Abyss" Style="{StaticResource SceneButton}"/>
                    <Button x:Name="Scene3Button" Content="03 - The First Relic" Style="{StaticResource SceneButton}"/>
                    <Button x:Name="Scene4Button" Content="04 - The Lost City Revealed" Style="{StaticResource SceneButton}"/>
                    <Button x:Name="Scene5Button" Content="05 - The Avenue of Giants" Style="{StaticResource SceneButton}"/>
                    <Button x:Name="Scene6Button" Content="06 - The Bio-Luminescent Garden" Style="{StaticResource SceneButton}"/>
                    <Button x:Name="Scene7Button" Content="07 - The Broken Observatory" Style="{StaticResource SceneButton}"/>
                    <Button x:Name="Scene8Button" Content="08 - Approach to the Sanctuary" Style="{StaticResource SceneButton}"/>
                    <Button x:Name="Scene9Button" Content="09 - The Dormant Symbol" Style="{StaticResource SceneButton}"/>
                    <Button x:Name="Scene10Button" Content="10 - The Gate Awakens" Style="{StaticResource SceneButton}"/>
                    <Button x:Name="Scene11Button" Content="11 - The Light Beyond" Style="{StaticResource SceneButton}"/>
                    <Button x:Name="Scene12Button" Content="12 - The Final Revelation" Style="{StaticResource SceneButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0">
            <TextBlock Text="QUALITY" Foreground="#FFD700" FontFamily="Consolas" FontSize="11" Margin="8,0,0,10" Opacity="0.7"/>
            <Button x:Name="QualityLow" Content="PERFORMANCE" Style="{StaticResource SceneButton}"/>
            <Button x:Name="QualityMedium" Content="BALANCED" Style="{StaticResource SceneButton}"/>
            <Button x:Name="QualityHigh" Content="CINEMATIC" Style="{StaticResource SceneButton}"/>
        </StackPanel>

        <Grid VerticalAlignment="Bottom" Margin="30,0,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText" Text="00:00" Foreground="#FFD700" FontFamily="Consolas" FontSize="11" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0" Maximum="330" Value="0" Height="20" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="05:30" Foreground="#FFD700" FontFamily="Consolas" FontSize="11" Margin="15,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="SceneNameText" Grid.Row="1"
                       Text="ABYSSAL - THE LOST CITY BENEATH THE OCEAN"
                       Foreground="#FFD700"
                       FontFamily="Consolas"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"
                       Opacity="0.6"/>

            <TextBlock Grid.Row="2"
                       Text="Press SPACE to play/pause | F11 for fullscreen"
                       Foreground="#FFD700"
                       FontFamily="Consolas"
                       FontSize="9"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Opacity="0.4"/>
        </Grid>

        <Border x:Name="TitleOverlay" Opacity="0" IsHitTestVisible="False">
            <Grid>
                <Border Background="#000000" Opacity="0.7"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="ABYSSAL"
                               Foreground="#FFD700"
                               FontFamily="Consolas"
                               FontSize="72"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="THE LOST CITY BENEATH THE OCEAN"
                               Foreground="#FFD700"
                               FontFamily="Consolas"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"
                               Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="FadeOverlay" Background="#000000" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</Window>
